generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  ADMIN
  MANAGER
  BOOKING
  RECEPTION
  WAITER
  KITCHEN
  BAR
  CASHIER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  NEW
  RETURNING
  VIP
  BLACKLIST
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ARRIVED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum BookingSource {
  PUBLIC
  STAFF
  PHONE
  FACEBOOK
  ZALO
  WALK_IN
}

enum BookingEventType {
  CREATED
  CONFIRMED
  ARRIVED
  CANCELLED
  NO_SHOW
  COMPLETED
  UPDATED
  TABLE_CHANGED
  NOTE_ADDED
  STATUS_CHANGED
}

enum Department {
  KITCHEN
  BAR
  SERVICE
  OTHER
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_PROCESSING
  PROCESSING
  READY
  SERVED
  PAYMENT_REQUESTED
  PAID
  CANCELLED
}

enum OrderSource {
  CUSTOMER_QR
  WAITER
  MANAGER
}

enum OrderItemStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum SessionStatus {
  OPEN
  PAYMENT_REQUESTED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  E_WALLET
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum ServiceRequestType {
  CALL_WAITER
  REQUEST_PAYMENT
  ADD_ICE
  CLEAN_TABLE
  OTHER
}

enum ServiceRequestStatus {
  PENDING
  DONE
  CANCELLED
}

enum OrderEventType {
  QR_SCANNED
  SESSION_OPENED
  ORDER_SUBMITTED
  ITEM_ACCEPTED
  ITEM_PREPARING
  ITEM_READY
  ITEM_SERVED
  PAYMENT_REQUESTED
  BILL_PAID
  ITEM_CANCELLED
  ORDER_CANCELLED
  TABLE_TRANSFERRED
  TABLE_MERGED
}

// ==================== MODELS ====================

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole   @default(BOOKING)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  createdBookings   Booking[]      @relation("CreatedByUser")
  confirmedBookings Booking[]      @relation("ConfirmedByUser")
  checkedInBookings Booking[]      @relation("CheckedInByUser")
  bookingEvents     BookingEvent[]
  customerNotes     CustomerNote[]

  openedSessions    TableSession[] @relation("OpenedByUser")
  closedSessions    TableSession[] @relation("ClosedByUser")
  createdOrders     Order[]
  orderEvents       OrderEvent[]
  payments          Payment[]
  resolvedRequests  ServiceRequest[] @relation("ResolvedByUser")

  @@map("users")
}

model Customer {
  id           String       @id @default(cuid())
  name         String
  phone        String       @unique
  note         String?
  customerType CustomerType @default(NEW)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  bookings      Booking[]
  customerNotes CustomerNote[]

  @@map("customers")
}

model TableArea {
  id          String   @id @default(cuid())
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tables RestaurantTable[]

  @@map("table_areas")
}

model RestaurantTable {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String
  areaId        String
  status        TableStatus @default(AVAILABLE)
  minGuests     Int         @default(2)
  maxGuests     Int         @default(4)
  depositAmount Decimal     @default(0) @db.Decimal(12, 0)
  minSpend      Decimal     @default(0) @db.Decimal(12, 0)
  note          String?
  posX          Float       @default(0)
  posY          Float       @default(0)
  width         Float       @default(36)
  height        Float       @default(22)
  qrToken       String?     @unique @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  area            TableArea       @relation(fields: [areaId], references: [id])
  bookings        Booking[]
  sessions        TableSession[]
  serviceRequests ServiceRequest[]

  @@map("restaurant_tables")
}

model Booking {
  id                String        @id @default(cuid())
  bookingCode       String        @unique
  customerId        String
  tableId           String
  bookingDate       DateTime      @db.Date
  bookingTime       String
  guestCount        Int
  status            BookingStatus @default(PENDING)
  depositAmount     Decimal       @default(0) @db.Decimal(12, 0)
  minSpend          Decimal       @default(0) @db.Decimal(12, 0)
  note              String?
  source            BookingSource @default(PUBLIC)
  createdByUserId   String?
  confirmedByUserId String?
  checkedInByUserId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer        Customer        @relation(fields: [customerId], references: [id])
  table           RestaurantTable @relation(fields: [tableId], references: [id])
  createdByUser   User?           @relation("CreatedByUser", fields: [createdByUserId], references: [id])
  confirmedByUser User?           @relation("ConfirmedByUser", fields: [confirmedByUserId], references: [id])
  checkedInByUser User?           @relation("CheckedInByUser", fields: [checkedInByUserId], references: [id])
  events          BookingEvent[]
  sessions        TableSession[]

  @@map("bookings")
}

model BookingEvent {
  id        String           @id @default(cuid())
  bookingId String
  userId    String?
  type      BookingEventType
  oldStatus BookingStatus?
  newStatus BookingStatus?
  note      String?
  createdAt DateTime         @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@map("booking_events")
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  userId     String
  note       String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@map("customer_notes")
}

// ==================== MENU ====================

model MenuCategory {
  id                String     @id @default(cuid())
  name              String
  departmentDefault Department @default(KITCHEN)
  sortOrder         Int        @default(0)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  items MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id                     String     @id @default(cuid())
  name                   String
  slug                   String     @unique
  description            String?
  price                  Decimal    @db.Decimal(12, 0)
  imageUrl               String?
  categoryId             String
  department             Department @default(KITCHEN)
  isAvailable            Boolean    @default(true)
  isFeatured             Boolean    @default(false)
  preparationTimeMinutes Int        @default(15)
  sortOrder              Int        @default(0)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  category   MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@map("menu_items")
}

// ==================== ORDER ====================

model TableSession {
  id              String        @id @default(cuid())
  tableId         String
  bookingId       String?
  status          SessionStatus @default(OPEN)
  openedAt        DateTime      @default(now())
  closedAt        DateTime?
  openedByUserId  String?
  closedByUserId  String?
  subtotal        Decimal       @default(0) @db.Decimal(12, 0)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 0)
  serviceCharge   Decimal       @default(0) @db.Decimal(12, 0)
  totalAmount     Decimal       @default(0) @db.Decimal(12, 0)
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  table      RestaurantTable @relation(fields: [tableId], references: [id])
  booking    Booking?        @relation(fields: [bookingId], references: [id])
  openedBy   User?           @relation("OpenedByUser", fields: [openedByUserId], references: [id])
  closedBy   User?           @relation("ClosedByUser", fields: [closedByUserId], references: [id])
  orders     Order[]
  payments   Payment[]
  events     OrderEvent[]
  serviceRequests ServiceRequest[]

  @@map("table_sessions")
}

model Order {
  id              String      @id @default(cuid())
  orderCode       String      @unique
  tableSessionId  String
  customerName    String?
  customerPhone   String?
  createdByUserId String?
  source          OrderSource @default(CUSTOMER_QR)
  status          OrderStatus @default(SUBMITTED)
  subtotal        Decimal     @default(0) @db.Decimal(12, 0)
  note            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  session    TableSession @relation(fields: [tableSessionId], references: [id])
  createdBy  User?        @relation(fields: [createdByUserId], references: [id])
  items      OrderItem[]
  events     OrderEvent[]

  @@map("orders")
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  menuItemId       String
  itemNameSnapshot String
  priceSnapshot    Decimal         @db.Decimal(12, 0)
  quantity         Int             @default(1)
  totalPrice       Decimal         @db.Decimal(12, 0)
  note             String?
  department       Department      @default(KITCHEN)
  status           OrderItemStatus @default(PENDING)
  cancelReason     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  events   OrderEvent[]

  @@map("order_items")
}

model Payment {
  id              String        @id @default(cuid())
  tableSessionId  String
  amount          Decimal       @db.Decimal(12, 0)
  method          PaymentMethod @default(CASH)
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  cashierUserId   String?
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  session TableSession @relation(fields: [tableSessionId], references: [id])
  cashier User?        @relation(fields: [cashierUserId], references: [id])

  @@map("payments")
}

model OrderEvent {
  id              String         @id @default(cuid())
  orderId         String?
  orderItemId     String?
  tableSessionId  String?
  type            OrderEventType
  payload         Json?
  createdByUserId String?
  createdAt       DateTime       @default(now())

  order      Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem  OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  session    TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  createdBy  User?        @relation(fields: [createdByUserId], references: [id])

  @@map("order_events")
}

model ServiceRequest {
  id               String               @id @default(cuid())
  tableId          String
  tableSessionId   String?
  type             ServiceRequestType
  note             String?
  status           ServiceRequestStatus @default(PENDING)
  createdAt        DateTime             @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?

  table    RestaurantTable @relation(fields: [tableId], references: [id])
  session  TableSession?   @relation(fields: [tableSessionId], references: [id])
  resolvedBy User?         @relation("ResolvedByUser", fields: [resolvedByUserId], references: [id])

  @@map("service_requests")
}
